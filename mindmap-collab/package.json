{
  "name": "mindmap-collab",
  "version": "0.1.0",
  "private": true,
  "description": "协同思维导图与大纲同步工具",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run start:dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run start:dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "smoke": "npx esbuild scripts/smoke-tree.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-tree.mjs && node node_modules/.cache/smoke-tree.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
